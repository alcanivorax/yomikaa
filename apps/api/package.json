{
  "name": "@yomikaa/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "build": "prisma generate && nest build",
    "postinstall": "prisma generate",
    "start": "node dist/main",
    "lint": "eslint",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.seed.json",
    "pretest": "nest build",
    "test": "jest",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@nestjs/common": "12.1.3",
    "@nestjs/core": "12.1.3",
    "@nestjs/platform-express": "12.1.3",
    "@nestjs/throttler": "6.7.1",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@supabase/supabase-js": "^2.118.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@yomikaa/shared": "workspace:*",
    "dotenv": "^18.0.8",
    "express": "^5.1.0",
    "helmet": "8.3.0",
    "jsonwebtoken": "^9.0.3",
    "jwks-rsa": "^4.1.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@nestjs/cli": "12.0.8",
    "@nestjs/testing": "12.1.3",
    "@types/express": "^5",
    "@types/jest": "^30",
    "@types/node": "^20",
    "@types/supertest": "^6",
    "eslint": "^9",
    "jest": "30.5.2",
    "prisma": "7.10.1",
    "supertest": "7.3.1",
    "ts-jest": "29.4.15",
    "tsx": "^4",
    "typescript": "^5",
    "typescript-eslint": "^8"
  }
}
