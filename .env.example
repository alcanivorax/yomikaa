# Marginalia environment variables.
# Copy the api block to apps/api/.env and the web block to apps/web/.env.local,
# then fill in the values for your environment.

# ── apps/api/.env ─────────────────────────────────────────────
# Pooled Postgres connection string (Supabase pooled string in production)
DATABASE_URL=postgresql://marginalia:marginalia@127.0.0.1:5432/marginalia
# Direct Postgres connection string, used by Prisma migrations
DIRECT_URL=postgresql://marginalia:marginalia@127.0.0.1:5432/marginalia
# The owner's user id (uuid). This is the subject of every session token, and
# the only value OwnerGuard accepts.
OWNER_USER_ID=00000000-0000-4000-8000-000000000001
# The single owner login. OWNER_USERNAME is required.
OWNER_USERNAME=owner
# Preferred: a scrypt hash of the password, generated with
#   pnpm hash:password 'your password'
# Set OWNER_PASSWORD_HASH in production; set it OR the plaintext OWNER_PASSWORD
# below. When both are set, the hash wins.
OWNER_PASSWORD_HASH=
# Plaintext fallback (local dev only). Compared in constant time.
OWNER_PASSWORD=owner
# HMAC secret used to sign and verify session tokens. Use a long random string
# (e.g. `openssl rand -base64 48`) in production. Rotating it signs everyone out.
AUTH_SECRET=change-me-to-a-long-random-string
# Allowed browser origin for CORS (only needed when the browser calls the API
# cross-origin, e.g. plain local dev; on Vercel the web service is same-origin).
WEB_ORIGIN=http://localhost:3000
PORT=4000

# ── apps/web/.env.local ───────────────────────────────────────
# API base URL for the browser. In plain local dev it points at the API
# directly; on Vercel leave it unset so the browser calls same-origin /api/v1,
# which vercel.json rewrites to the api service.
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
# API origin (scheme://host[:port], no path) for server-side fetches in
# Next.js. On Vercel this is injected automatically by the api service
# binding (vercel.json) — do not set it in the project env there.
API_URL=http://localhost:4000
# Optional (web only): show the 12 built-in sample notes when the API is
# unreachable or the database is empty. Server-side only. Leave unset (off) in
# production; set to true locally for a demo experience without a database.
SHOW_SAMPLE_NOTES=true
