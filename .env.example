# Marginalia environment variables.
# Copy the api block to apps/api/.env and the web block to apps/web/.env.local,
# then fill in the values for your environment.

# ── apps/api/.env ─────────────────────────────────────────────
# Pooled Postgres connection string (Supabase pooled string in production)
DATABASE_URL=postgresql://marginalia:marginalia@127.0.0.1:5432/marginalia
# Direct Postgres connection string, used by Prisma migrations
DIRECT_URL=postgresql://marginalia:marginalia@127.0.0.1:5432/marginalia
# Supabase project URL (used to derive the JWKS endpoint). Leave empty in local dev.
SUPABASE_URL=
# The owner's Supabase auth user id (uuid)
OWNER_USER_ID=00000000-0000-4000-8000-000000000001
# Dev-only sign-in secret. When set, POST /api/v1/auth/dev-token mints an owner
# token for local development and tests. Leave empty in production.
AUTH_DEV_SECRET=change-me-dev-only
# Allowed browser origin for CORS
WEB_ORIGIN=http://localhost:3000
PORT=4000

# ── apps/web/.env.local ───────────────────────────────────────
# Supabase project URL and anon key for browser sign-in. Leave empty in local dev.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# API base URL for the browser
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
# API base URL for server-side fetches in Next.js
API_URL=http://localhost:4000/api/v1
# Dev-only sign-in secret used by the /api/dev-login route when Supabase Auth
# is not configured. Must match apps/api's AUTH_DEV_SECRET. Leave empty in production.
AUTH_DEV_SECRET=change-me-dev-only
