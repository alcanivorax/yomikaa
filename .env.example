# Marginalia environment variables.
# Copy the api block to apps/api/.env and the web block to apps/web/.env.local,
# then fill in the values for your environment.

# ── apps/api/.env ─────────────────────────────────────────────
# Pooled Postgres connection string (Supabase pooled string in production)
DATABASE_URL=postgresql://marginalia:marginalia@127.0.0.1:5432/marginalia
# Direct Postgres connection string, used by Prisma migrations
DIRECT_URL=postgresql://marginalia:marginalia@127.0.0.1:5432/marginalia

# ── Supabase Auth ─────────────────────────────────────────────
# Your Supabase project URL (Settings → API → Project URL).
SUPABASE_URL=https://your-project.supabase.co
# The public anon / publishable key (Settings → API). Safe to expose; used
# server-side here for password sign-in and refresh. No service-role key is
# required (or used) anywhere in this app.
SUPABASE_ANON_KEY=your-anon-or-publishable-key
# The project JWT secret (Settings → API → JWT Secret), used to verify HS256
# access tokens locally. If your project issues RS256 tokens instead, this can
# be left blank and tokens are verified against the project JWKS at
# $SUPABASE_URL/auth/v1/.well-known/jwks.json.
SUPABASE_JWT_SECRET=your-jwt-secret
# The owner's real Supabase Auth user uuid (the `sub` claim). Only this user is
# granted owner access. Find it in Supabase Auth → Users after inviting/creating
# the owner account.
SUPABASE_OWNER_USER_ID=00000000-0000-4000-8000-000000000002
# The data-scoping owner id written to JournalDay/Ticket/Draft rows. For an
# existing deployment this must match the ids already in your database so old
# rows stay visible; for a fresh install set it equal to SUPABASE_OWNER_USER_ID.
OWNER_USER_ID=00000000-0000-4000-8000-000000000001

# Allowed browser origin for CORS (only needed when the browser calls the API
# cross-origin, e.g. plain local dev; on Vercel the web service is same-origin).
WEB_ORIGIN=http://localhost:3000
PORT=4000

# ── apps/web/.env.local ───────────────────────────────────────
# API origin (scheme://host[:port], no path) for server-side fetches in
# Next.js. On Vercel this is injected automatically by the api service
# binding (vercel.json) — do not set it in the project env there.
API_URL=http://localhost:4000
# Optional (web only): show the 12 built-in sample notes when the API is
# unreachable or the database is empty. Server-side only. Leave unset (off) in
# production; set to true locally for a demo experience without a database.
SHOW_SAMPLE_NOTES=true
